# ─── Base de données (ta base Postgres existante sur le VPS) ───
# Ne pas créer de nouvelle base : on pointe vers celle qui contient déjà
# matches / team / players / guild_configs / prediction (utilisées par le bot Discord)
DATABASE_URL="postgresql://USER:PASSWORD@VPS_HOST:5432/esportbot?schema=public"

# ─── Backend ───
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
ASSET_ORIGIN="http://51.38.38.87:3070"
HOST="0.0.0.0"
ASSET_SOURCE_ORIGIN="http://51.38.38.87:3070"
API_URL="http://localhost:4000"
WS_URL="ws://localhost:4000/ws/matches"

# ─── Frontend ───
NUXT_PUBLIC_API_BASE="http://localhost:4000/api"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
